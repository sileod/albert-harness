#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

API_BASE = os.environ.get("ALBERT_BASE_URL", "https://albert.api.etalab.gouv.fr/v1").rstrip("/")
DEFAULT_MODEL = os.environ.get("ALBERT_MODEL", "deepseek-v4-flash")
CONTEXT_WINDOW = 131072
MAX_OUTPUT = 65536


def die(message, code=1):
    print(f"albert: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_key():
    key = os.environ.get("ALBERT_API_KEY", "").strip()
    if not key:
        die("ALBERT_API_KEY is not set")
    return key


def require_command(name, install_hint):
    path = shutil.which(name)
    if not path:
        die(f"{name} is not installed. {install_hint}")
    return path


def deep_merge(base, overlay):
    if not isinstance(base, dict) or not isinstance(overlay, dict):
        return overlay
    result = dict(base)
    for key, value in overlay.items():
        result[key] = deep_merge(result.get(key), value) if key in result else value
    return result


def opencode_config(model, existing=None):
    config = {
        "$schema": "https://opencode.ai/config.json",
        "provider": {
            "albert": {
                "npm": "@ai-sdk/openai-compatible",
                "name": "Albert API",
                "options": {
                    "baseURL": API_BASE,
                    "apiKey": "{env:ALBERT_API_KEY}",
                },
                "models": {
                    model: {
                        "name": model,
                        "limit": {"context": CONTEXT_WINDOW, "output": MAX_OUTPUT},
                    }
                },
            }
        },
        "model": f"albert/{model}",
        "small_model": f"albert/{model}",
    }
    return deep_merge(existing or {}, config)


def cmd_opencode(args):
    require_key()
    executable = require_command("opencode", "See https://opencode.ai/docs/")
    existing = {}
    raw = os.environ.get("OPENCODE_CONFIG_CONTENT")
    if raw:
        try:
            existing = json.loads(raw)
        except json.JSONDecodeError as exc:
            die(f"OPENCODE_CONFIG_CONTENT is not valid JSON: {exc}")
    env = os.environ.copy()
    env["OPENCODE_CONFIG_CONTENT"] = json.dumps(opencode_config(args.model, existing), separators=(",", ":"))
    os.execvpe(executable, [executable, *args.harness_args], env)


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def litellm_config(model):
    return f'''litellm_settings:\n  drop_params: true\nmodel_list:\n  - model_name: {model}\n    litellm_params:\n      model: custom_openai/{model}\n      api_base: {API_BASE}\n      api_key: os.environ/ALBERT_API_KEY\n'''


def wait_for_port(process, port, timeout=15):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            die("LiteLLM bridge exited during startup")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                return
        except OSError:
            time.sleep(0.1)
    process.terminate()
    die("LiteLLM bridge did not start")


def run_with_bridge(model, callback):
    require_key()
    litellm = require_command(
        "litellm",
        "Install the bridge with `python -m pip install 'litellm[proxy]'`.",
    )
    port = free_port()
    with tempfile.TemporaryDirectory(prefix="albert-harness-") as tmp:
        config_path = os.path.join(tmp, "litellm.yaml")
        with open(config_path, "w", encoding="utf-8") as file:
            file.write(litellm_config(model))
        debug = os.environ.get("ALBERT_DEBUG") == "1"
        stdio = {} if debug else {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        bridge_env = os.environ.copy()
        bridge_env.setdefault("LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES", "true")
        process = subprocess.Popen(
            [litellm, "--config", config_path, "--host", "127.0.0.1", "--port", str(port)],
            env=bridge_env,
            **stdio,
        )
        try:
            wait_for_port(process, port)
            return callback(port)
        finally:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()


def cmd_codex(args):
    executable = require_command("codex", "See https://developers.openai.com/codex/cli/")

    def launch(port):
        provider = (
            '{ name = "Albert API", '
            f'base_url = "http://127.0.0.1:{port}/v1", '
            'env_key = "ALBERT_PROXY_KEY", wire_api = "responses", requires_openai_auth = false }'
        )
        env = os.environ.copy()
        env["ALBERT_PROXY_KEY"] = "local"
        command = [
            executable,
            "-c",
            'model_provider="albert"',
            "-c",
            f'model="{args.model}"',
            "-c",
            f"model_providers.albert={provider}",
            *args.harness_args,
        ]
        return subprocess.call(command, env=env)

    raise SystemExit(run_with_bridge(args.model, launch))


def cmd_claude(args):
    executable = require_command("claude", "See https://docs.anthropic.com/en/docs/claude-code/")

    def launch(port):
        env = os.environ.copy()
        env.update(
            {
                "ANTHROPIC_BASE_URL": f"http://127.0.0.1:{port}",
                "ANTHROPIC_AUTH_TOKEN": "local",
            }
        )
        return subprocess.call([executable, "--model", args.model, *args.harness_args], env=env)

    print("albert: Claude Code support is experimental", file=sys.stderr)
    raise SystemExit(run_with_bridge(args.model, launch))


def cmd_models(_args):
    key = require_key()
    request = urllib.request.Request(
        f"{API_BASE}/models",
        headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as exc:
        die(f"Albert API returned HTTP {exc.code}")
    except urllib.error.URLError as exc:
        die(f"cannot reach Albert API: {exc.reason}")
    models = payload.get("data", payload if isinstance(payload, list) else [])
    for model in models:
        if isinstance(model, dict) and model.get("id"):
            print(model["id"])


def parser():
    root = argparse.ArgumentParser(prog="albert", description="Run coding harnesses against Albert API")
    root.add_argument("--version", action="version", version="albert-harness 0.1.1")
    sub = root.add_subparsers(dest="command", required=True)

    for name, handler, help_text in [
        ("opencode", cmd_opencode, "Run OpenCode directly against Albert"),
        ("codex", cmd_codex, "Run Codex through a local Responses bridge"),
        ("claude", cmd_claude, "Run Claude Code through a local Messages bridge (experimental)"),
    ]:
        command = sub.add_parser(name, help=help_text)
        command.add_argument("--model", default=DEFAULT_MODEL)
        command.set_defaults(func=handler)

    models = sub.add_parser("models", help="List model IDs returned by Albert")
    models.set_defaults(func=cmd_models)
    return root


def main():
    root = parser()
    args, rest = root.parse_known_args()
    if args.command == "models" and rest:
        root.error(f"unrecognized arguments: {' '.join(rest)}")
    args.harness_args = rest[1:] if rest[:1] == ["--"] else rest
    args.func(args)


if __name__ == "__main__":
    main()
