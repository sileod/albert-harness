def patch_oauth(provider, path):
    text = path.read_text()
    old = '''export async function getOrPromptApiKey(agentSlug?: string, cloudSlug?: string): Promise<string> {
  process.stderr.write("\\n");'''
    new = render('''export async function getOrPromptApiKey(agentSlug?: string, cloudSlug?: string): Promise<string> {
  if (process.env.@@KEY_ENV@@) {
    return process.env.@@KEY_ENV@@;
  }
  process.stderr.write("\\n");''', provider)
    path.write_text(replace_once(provider, text, old, new, "API key acquisition"))


def patch_sandbox(provider, path):
    text = path.read_text()
    old = '''  await runLocalArgs([
    "docker",
    "run",
    "-d",
    "--name",
    DOCKER_CONTAINER_NAME,
    image,
  ]);'''
    new = '''  const dockerArgs = ["docker", "run", "-d", "--name", DOCKER_CONTAINER_NAME];
  const workspace = process.env.HARNESS_LINK_WORKSPACE;
  if (workspace) {
    dockerArgs.push("-v", `${workspace}:/workspace`, "-w", "/workspace");
  }
  dockerArgs.push(image);
  await runLocalArgs(dockerArgs);'''
    path.write_text(replace_once(provider, text, old, new, "sandbox workspace mount"))


def cache_dir(provider):
    root = os.environ.get("XDG_CACHE_HOME")
    base = Path(root).expanduser() if root else Path.home() / ".cache"
    return base / "harness-link" / f"{provider.slug}-spawn"


def ensure_spawn(provider):
    git = require_command(provider, "git", "Install git first.")
    bun = require_command(provider, "bun", "Install Bun from https://bun.sh/.")
    root = cache_dir(provider)
    checkout = root / "src"
    binary = root / "spawn"
    stamp = root / "stamp"
    root.mkdir(parents=True, exist_ok=True)

    if not (checkout / ".git").exists():
        if checkout.exists():
            shutil.rmtree(checkout)
        run(provider, [git, "clone", "--filter=blob:none", "--no-checkout", SPAWN_REPO, str(checkout)])

    run(provider, [git, "fetch", "--depth", "1", "origin", provider.spawn_ref], cwd=checkout)
    resolved = run(provider, [git, "rev-parse", "FETCH_HEAD"], cwd=checkout, capture=True).stdout.strip()
    expected_stamp = f"{resolved}:{PATCH_VERSION}"
    if binary.exists() and stamp.exists() and stamp.read_text().strip() == expected_stamp:
        return binary

    run(provider, [git, "reset", "--hard", "FETCH_HEAD"], cwd=checkout)
    run(provider, [git, "clean", "-fdx"], cwd=checkout)
    patch_agent_setup(provider, checkout / "packages/cli/src/shared/agent-setup.ts")
    patch_oauth(provider, checkout / "packages/cli/src/shared/oauth.ts")
    patch_sandbox(provider, checkout / "packages/cli/src/local/local.ts")

    env = os.environ.copy()
    env["HUSKY"] = "0"
    run(provider, [bun, "install", "--frozen-lockfile"], cwd=checkout, env=env)
    run(provider, [bun, "run", "compile"], cwd=checkout / "packages/cli", env=env)
    shutil.copy2(checkout / "packages/cli/spawn", binary)
    binary.chmod(0o755)
    stamp.write_text(expected_stamp + "\n")
    return binary


def with_default_model(provider, args):
    if not args or args[0] not in SUPPORTED_AGENTS or "--model" in args:
        return args
    return [*args, "--model", provider.model]


def extract_workspace(provider, args):
    args = list(args)
    workspace = None
    for index, arg in enumerate(list(args)):
        if arg == "--workspace":
            if index + 1 >= len(args):
                die(provider, "--workspace requires a path")
            workspace = args[index + 1]
            del args[index : index + 2]
            break
        if arg.startswith("--workspace="):
            workspace = arg.split("=", 1)[1]
            del args[index]
            break

    is_sandbox = len(args) >= 2 and args[1] == "sandbox"
    if not is_sandbox:
        if workspace is not None:
            die(provider, "--workspace is only valid with the sandbox cloud")
        return args, None

    path = Path(workspace or os.getcwd()).expanduser().resolve()
    if not path.is_dir():
        die(provider, f"workspace is not a directory: {path}")
    return args, str(path)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] not in PROVIDERS:
        names = ", ".join(PROVIDERS)
        print(f"usage: harness-link-spawn <provider> ...\nproviders: {names}", file=sys.stderr)
        raise SystemExit(2)
    provider = PROVIDERS[argv.pop(0)]
    if not os.environ.get(provider.key_env, "").strip():
        die(provider, f"{provider.key_env} is not set")
    args, workspace = extract_workspace(provider, argv)
    if args and args[0] in KNOWN_AGENTS and args[0] not in SUPPORTED_AGENTS:
        print(
            f"{provider.slug} spawn: {args[0]} still uses OpenRouter-specific integration upstream; continuing best-effort",
            file=sys.stderr,
        )
    binary = ensure_spawn(provider)
    env = os.environ.copy()
    env.setdefault("SPAWN_TELEMETRY", "0")
    if workspace:
        env["HARNESS_LINK_WORKSPACE"] = workspace
    os.execve(binary, [str(binary), *with_default_model(provider, args)], env)


if __name__ == "__main__":
    main()
