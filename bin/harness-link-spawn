#!/usr/bin/env python3
from dataclasses import dataclass
import os
from pathlib import Path
import shutil
import subprocess
import sys

SPAWN_REPO = "https://github.com/OpenRouterLabs/spawn.git"
DEFAULT_SPAWN_REF = "1bec53ef997634e3e7cc63f8414a702aa1d4c82e"
PATCH_VERSION = "4"
SUPPORTED_AGENTS = {"opencode", "hermes", "codex", "claude"}
KNOWN_AGENTS = {
    "claude",
    "openclaw",
    "codex",
    "opencode",
    "kilocode",
    "hermes",
    "junie",
    "pi",
    "t3code",
    "cursor",
}


@dataclass(frozen=True)
class Provider:
    slug: str
    name: str
    key_env: str
    base_env: str
    default_base: str
    model_env: str
    default_model: str
    spawn_ref_env: str
    opencode_limit: str = ""

    @property
    def model(self):
        return os.environ.get(self.model_env, self.default_model)

    @property
    def spawn_ref(self):
        return os.environ.get(self.spawn_ref_env, DEFAULT_SPAWN_REF)


PROVIDERS = {
    "albert": Provider(
        slug="albert",
        name="Albert API",
        key_env="ALBERT_API_KEY",
        base_env="ALBERT_BASE_URL",
        default_base="https://albert.api.etalab.gouv.fr/v1",
        model_env="ALBERT_MODEL",
        default_model="deepseek-v4-flash",
        spawn_ref_env="ALBERT_SPAWN_REF",
        opencode_limit=", limit: { context: 131072, output: 65536 }",
    ),
    "nim": Provider(
        slug="nim",
        name="NVIDIA NIM",
        key_env="NVIDIA_API_KEY",
        base_env="NIM_BASE_URL",
        default_base="https://integrate.api.nvidia.com/v1",
        model_env="NIM_MODEL",
        default_model="openai/gpt-oss-120b",
        spawn_ref_env="NIM_SPAWN_REF",
    ),
}


def die(provider, message, code=1):
    print(f"{provider.slug} spawn: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_command(provider, name, hint):
    path = shutil.which(name)
    if not path:
        die(provider, f"{name} is required. {hint}")
    return path


def run(provider, command, cwd=None, env=None, capture=False):
    kwargs = {"cwd": cwd, "env": env, "check": True}
    if capture:
        kwargs.update(text=True, stdout=subprocess.PIPE)
    try:
        return subprocess.run(command, **kwargs)
    except subprocess.CalledProcessError as exc:
        die(provider, f"command failed ({exc.returncode}): {' '.join(map(str, command))}")


def replace_once(provider, text, old, new, label):
    count = text.count(old)
    if count != 1:
        die(provider, f"upstream Spawn changed around {label}; expected one match, found {count}")
    return text.replace(old, new, 1)


def render(template, provider):
    replacements = {
        "@@SLUG@@": provider.slug,
        "@@NAME@@": provider.name,
        "@@KEY_ENV@@": provider.key_env,
        "@@BASE_ENV@@": provider.base_env,
        "@@DEFAULT_BASE@@": provider.default_base,
        "@@MODEL_ENV@@": provider.model_env,
        "@@DEFAULT_MODEL@@": provider.default_model,
        "@@OPENCODE_LIMIT@@": provider.opencode_limit,
    }
    for old, new in replacements.items():
        template = template.replace(old, new)
    return template


def patch_agent_setup(provider, path):
    text = path.read_text()
    marker = "// ─── Default Agent Definitions ───────────────────────────────────────────────\n"
    helpers = render(r'''const HL_PROVIDER = "@@SLUG@@";
const HL_PROVIDER_NAME = "@@NAME@@";
const HL_API_BASE = process.env.@@BASE_ENV@@ || "@@DEFAULT_BASE@@";
const HL_DEFAULT_MODEL = process.env.@@MODEL_ENV@@ || "@@DEFAULT_MODEL@@";
const HL_PROXY_PORT = 4141;

async function setupHarnessLinkOpenCodeConfig(runner: CloudRunner, _apiKey: string, modelId?: string): Promise<void> {
  const model = modelId || HL_DEFAULT_MODEL;
  const config = JSON.stringify({
    $schema: "https://opencode.ai/config.json",
    provider: {
      [HL_PROVIDER]: {
        npm: "@ai-sdk/openai-compatible",
        name: HL_PROVIDER_NAME,
        options: { baseURL: HL_API_BASE, apiKey: "{env:@@KEY_ENV@@}" },
        models: { [model]: { name: model@@OPENCODE_LIMIT@@ } },
      },
    },
    model: `${HL_PROVIDER}/${model}`,
    small_model: `${HL_PROVIDER}/${model}`,
  }, null, 2) + "\n";
  await uploadConfigFile(runner, config, "$HOME/.config/opencode/opencode.json");
}

async function setupHarnessLinkLiteLLMBridge(runner: CloudRunner, modelId?: string): Promise<void> {
  const model = modelId || HL_DEFAULT_MODEL;
  const config = [
    "litellm_settings:",
    "  drop_params: true",
    "model_list:",
    `  - model_name: ${JSON.stringify(model)}`,
    "    litellm_params:",
    `      model: ${JSON.stringify(`openai/${model}`)}`,
    `      api_base: ${JSON.stringify(HL_API_BASE)}`,
    "      api_key: os.environ/@@KEY_ENV@@",
    "      use_chat_completions_api: true",
    "",
  ].join("\n");
  const configDir = `$HOME/.config/harness-link/${HL_PROVIDER}`;
  await uploadConfigFile(runner, config, `${configDir}/litellm.yaml`);
  const script = [
    "source ~/.spawnrc 2>/dev/null",
    "export PATH=$HOME/.local/bin:$PATH",
    "_venv=$HOME/.local/share/harness-link-litellm",
    "if [ ! -x $_venv/bin/litellm ]; then",
    "  python3 -m venv $_venv 2>/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq python3-venv; python3 -m venv $_venv; }",
    "  $_venv/bin/pip install -q 'litellm[proxy]'",
    "fi",
    `pkill -f 'litellm.*harness-link/${HL_PROVIDER}/litellm.yaml' 2>/dev/null || true`,
    "export LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=true",
    `nohup $_venv/bin/litellm --config $HOME/.config/harness-link/${HL_PROVIDER}/litellm.yaml --host 127.0.0.1 --port ${HL_PROXY_PORT} >$HOME/.config/harness-link/${HL_PROVIDER}/litellm.log 2>&1 </dev/null &`,
    `for _i in $(seq 1 30); do curl -fsS http://127.0.0.1:${HL_PROXY_PORT}/health/liveliness >/dev/null 2>&1 && exit 0; sleep 1; done`,
    `tail -40 $HOME/.config/harness-link/${HL_PROVIDER}/litellm.log >&2 || true`,
    "exit 1",
  ].join("\n");
  await runner.runServer(script, 300);
}

async function setupHarnessLinkCodexConfig(runner: CloudRunner, _apiKey: string, modelId?: string): Promise<void> {
  const model = modelId || HL_DEFAULT_MODEL;
  await setupHarnessLinkLiteLLMBridge(runner, model);
  const config = `model = "${model}"
model_provider = "${HL_PROVIDER}"
sandbox_mode = "danger-full-access"

[model_providers.${HL_PROVIDER}]
name = "${HL_PROVIDER_NAME}"
base_url = "http://127.0.0.1:${HL_PROXY_PORT}/v1"
env_key = "HARNESS_LINK_PROXY_KEY"
wire_api = "responses"
`;
  await uploadConfigFile(runner, config, "$HOME/.codex/config.toml");
}

