#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import subprocess
import sys

SPAWN_REPO = "https://github.com/OpenRouterLabs/spawn.git"
SPAWN_REF = os.environ.get("ALBERT_SPAWN_REF", "1bec53ef997634e3e7cc63f8414a702aa1d4c82e")
PATCH_VERSION = "1"
DEFAULT_MODEL = os.environ.get("ALBERT_MODEL", "deepseek-v4-flash")
SUPPORTED_AGENTS = {"opencode", "hermes", "codex", "claude"}
KNOWN_AGENTS = {
    "claude",
    "openclaw",
    "codex",
    "opencode",
    "kilocode",
    "hermes",
    "junie",
    "pi",
    "t3code",
    "cursor",
}


def die(message, code=1):
    print(f"albert spawn: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_command(name, hint):
    path = shutil.which(name)
    if not path:
        die(f"{name} is required. {hint}")
    return path


def run(command, cwd=None, env=None, capture=False):
    kwargs = {"cwd": cwd, "env": env, "check": True}
    if capture:
        kwargs.update(text=True, stdout=subprocess.PIPE)
    try:
        return subprocess.run(command, **kwargs)
    except subprocess.CalledProcessError as exc:
        die(f"command failed ({exc.returncode}): {' '.join(map(str, command))}")


def replace_once(text, old, new, label):
    count = text.count(old)
    if count != 1:
        die(f"upstream Spawn changed around {label}; expected one match, found {count}")
    return text.replace(old, new, 1)


def patch_agent_setup(path):
    text = path.read_text()
    marker = "// ─── Default Agent Definitions ───────────────────────────────────────────────\n"
    helpers = r'''const ALBERT_API_BASE = process.env.ALBERT_BASE_URL || "https://albert.api.etalab.gouv.fr/v1";
const ALBERT_DEFAULT_MODEL = process.env.ALBERT_MODEL || "deepseek-v4-flash";
const ALBERT_PROXY_PORT = 4141;

async function setupAlbertOpenCodeConfig(runner: CloudRunner, _apiKey: string, modelId?: string): Promise<void> {
  const model = modelId || ALBERT_DEFAULT_MODEL;
  const config = JSON.stringify({
    $schema: "https://opencode.ai/config.json",
    provider: {
      albert: {
        npm: "@ai-sdk/openai-compatible",
        name: "Albert API",
        options: { baseURL: ALBERT_API_BASE, apiKey: "{env:ALBERT_API_KEY}" },
        models: {
          [model]: {
            name: model,
            limit: { context: 131072, output: 65536 },
          },
        },
      },
    },
    model: `albert/${model}`,
    small_model: `albert/${model}`,
  }, null, 2) + "\n";
  await uploadConfigFile(runner, config, "$HOME/.config/opencode/opencode.json");
}

async function setupAlbertLiteLLMBridge(runner: CloudRunner, modelId?: string): Promise<void> {
  const model = modelId || ALBERT_DEFAULT_MODEL;
  const config = `model_list:\n  - model_name: ${model}\n    litellm_params:\n      model: openai/chat_completions/${model}\n      api_base: ${ALBERT_API_BASE}\n      api_key: os.environ/ALBERT_API_KEY\n`;
  await uploadConfigFile(runner, config, "$HOME/.config/albert/litellm.yaml");
  const script = [
    "source ~/.spawnrc 2>/dev/null",
    "export PATH=$HOME/.local/bin:$PATH",
    "_venv=$HOME/.local/share/albert-litellm",
    "if [ ! -x $_venv/bin/litellm ]; then",
    "  python3 -m venv $_venv 2>/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq python3-venv; python3 -m venv $_venv; }",
    "  $_venv/bin/pip install -q 'litellm[proxy]'",
    "fi",
    "pkill -f 'litellm.*albert/litellm.yaml' 2>/dev/null || true",
    "export LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=true",
    `nohup $_venv/bin/litellm --config $HOME/.config/albert/litellm.yaml --host 127.0.0.1 --port ${ALBERT_PROXY_PORT} >$HOME/.config/albert/litellm.log 2>&1 </dev/null &`,
    `for _i in $(seq 1 60); do nc -z 127.0.0.1 ${ALBERT_PROXY_PORT} 2>/dev/null && exit 0; sleep 1; done`,
    "tail -40 $HOME/.config/albert/litellm.log >&2 || true",
    "exit 1",
  ].join("\n");
  await runner.runServer(script, 300);
}

async function setupAlbertCodexConfig(runner: CloudRunner, _apiKey: string, modelId?: string): Promise<void> {
  const model = modelId || ALBERT_DEFAULT_MODEL;
  await setupAlbertLiteLLMBridge(runner, model);
  const config = `model = "${model}"
model_provider = "albert"
sandbox_mode = "danger-full-access"

[model_providers.albert]
name = "Albert API"
base_url = "http://127.0.0.1:${ALBERT_PROXY_PORT}/v1"
env_key = "ALBERT_PROXY_KEY"
wire_api = "responses"
`;
  await uploadConfigFile(runner, config, "$HOME/.codex/config.toml");
}

async function setupAlbertClaudeConfig(runner: CloudRunner, _apiKey: string, modelId?: string): Promise<void> {
  const model = modelId || ALBERT_DEFAULT_MODEL;
  await setupAlbertLiteLLMBridge(runner, model);
  const settings = JSON.stringify({
    theme: "dark",
    editor: "vim",
    env: {
      CLAUDE_CODE_ENABLE_TELEMETRY: "0",
      ANTHROPIC_BASE_URL: `http://127.0.0.1:${ALBERT_PROXY_PORT}`,
      ANTHROPIC_AUTH_TOKEN: "local",
      ANTHROPIC_MODEL: model,
    },
    permissions: { defaultMode: "bypassPermissions", dangerouslySkipPermissions: true },
  }, null, 2) + "\n";
  await uploadConfigFile(runner, settings, "$HOME/.claude/settings.json");
  await runner.runServer('printf \'{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true,"projects":{"%s":{"hasTrustDialogAccepted":true}}}\\n\' "$HOME" > ~/.claude.json && chmod 600 ~/.claude.json');
}

'''
    text = replace_once(text, marker, helpers + marker, "Albert helper insertion")

    old = '''    claude: {
      name: "Claude Code",
      cloudInitTier: "minimal",
      preProvision: detectGithubAuth,
      install: () => installClaudeCode(runner),
      envVars: (apiKey) => [
        `OPENROUTER_API_KEY=${apiKey}`,
        "ANTHROPIC_BASE_URL=https://openrouter.ai/api",
        `ANTHROPIC_AUTH_TOKEN=${apiKey}`,
        "ANTHROPIC_API_KEY=",
        "CLAUDE_CODE_SKIP_ONBOARDING=1",
        "CLAUDE_CODE_ENABLE_TELEMETRY=0",
      ],
      configure: (apiKey) => setupClaudeCodeConfig(runner, apiKey),'''
    new = '''    claude: {
      name: "Claude Code",
      cloudInitTier: "minimal",
      modelDefault: ALBERT_DEFAULT_MODEL,
      preProvision: detectGithubAuth,
      install: () => installClaudeCode(runner),
      envVars: (apiKey) => [
        `ALBERT_API_KEY=${apiKey}`,
        "ALBERT_PROXY_KEY=local",
        `ANTHROPIC_BASE_URL=http://127.0.0.1:${ALBERT_PROXY_PORT}`,
        "ANTHROPIC_AUTH_TOKEN=local",
        "ANTHROPIC_API_KEY=",
        `ANTHROPIC_MODEL=${ALBERT_DEFAULT_MODEL}`,
        "CLAUDE_CODE_SKIP_ONBOARDING=1",
        "CLAUDE_CODE_ENABLE_TELEMETRY=0",
      ],
      configure: (apiKey, modelId) => setupAlbertClaudeConfig(runner, apiKey, modelId),'''
    text = replace_once(text, old, new, "Claude provider")

    old = '''    codex: {
      name: "Codex CLI",
      cloudInitTier: "node",
      preProvision: detectGithubAuth,'''
    new = '''    codex: {
      name: "Codex CLI",
      cloudInitTier: "node",
      modelDefault: ALBERT_DEFAULT_MODEL,
      preProvision: detectGithubAuth,'''
    text = replace_once(text, old, new, "Codex model")
    old = '''      envVars: (apiKey) => [
        `OPENROUTER_API_KEY=${apiKey}`,
      ],
      configure: () => setupCodexConfig(runner),'''
    new = '''      envVars: (apiKey) => [
        `ALBERT_API_KEY=${apiKey}`,
        "ALBERT_PROXY_KEY=local",
      ],
      configure: (apiKey, modelId) => setupAlbertCodexConfig(runner, apiKey, modelId),'''
    text = replace_once(text, old, new, "Codex provider")

    old = '''    opencode: {
      name: "OpenCode",
      cloudInitTier: "minimal",
      preProvision: detectGithubAuth,
      install: () => installAgent(runner, "OpenCode", openCodeInstallCmd()),
      envVars: (apiKey) => [
        `OPENROUTER_API_KEY=${apiKey}`,
      ],
      launchCmd: () => "source ~/.spawnrc 2>/dev/null; source ~/.zshrc 2>/dev/null; opencode",'''
    new = '''    opencode: {
      name: "OpenCode",
      cloudInitTier: "minimal",
      modelDefault: ALBERT_DEFAULT_MODEL,
      preProvision: detectGithubAuth,
      install: () => installAgent(runner, "OpenCode", openCodeInstallCmd()),
      envVars: (apiKey) => [
        `ALBERT_API_KEY=${apiKey}`,
      ],
      configure: (apiKey, modelId) => setupAlbertOpenCodeConfig(runner, apiKey, modelId),
      launchCmd: () => "source ~/.spawnrc 2>/dev/null; source ~/.zshrc 2>/dev/null; opencode",'''
    text = replace_once(text, old, new, "OpenCode provider")

    old = '''    hermes: {
      name: "Hermes Agent",
      cloudInitTier: "minimal",
      modelEnvVar: "LLM_MODEL",'''
    new = '''    hermes: {
      name: "Hermes Agent",
      cloudInitTier: "minimal",
      modelDefault: ALBERT_DEFAULT_MODEL,
      modelEnvVar: "LLM_MODEL",'''
    text = replace_once(text, old, new, "Hermes model")
    old = '''      envVars: (apiKey) => [
        `OPENROUTER_API_KEY=${apiKey}`,
        "OPENAI_BASE_URL=https://openrouter.ai/api/v1",
        `OPENAI_API_KEY=${apiKey}`,
        "HERMES_YOLO_MODE=1",
      ],'''
    new = '''      envVars: (apiKey) => [
        `ALBERT_API_KEY=${apiKey}`,
        `OPENAI_BASE_URL=${ALBERT_API_BASE}`,
        `OPENAI_API_KEY=${apiKey}`,
        "HERMES_YOLO_MODE=1",
      ],'''
    text = replace_once(text, old, new, "Hermes provider")
    path.write_text(text)


def patch_oauth(path):
    text = path.read_text()
    old = '''export async function getOrPromptApiKey(agentSlug?: string, cloudSlug?: string): Promise<string> {
  process.stderr.write("\\n");'''
    new = '''export async function getOrPromptApiKey(agentSlug?: string, cloudSlug?: string): Promise<string> {
  if (process.env.ALBERT_API_KEY) {
    return process.env.ALBERT_API_KEY;
  }
  process.stderr.write("\\n");'''
    path.write_text(replace_once(text, old, new, "API key acquisition"))


def cache_dir():
    root = os.environ.get("XDG_CACHE_HOME")
    if root:
        return Path(root).expanduser() / "albert-harness" / "spawn"
    return Path.home() / ".cache" / "albert-harness" / "spawn"


def ensure_spawn():
    git = require_command("git", "Install git first.")
    bun = require_command("bun", "Install Bun from https://bun.sh/.")
    root = cache_dir()
    checkout = root / "src"
    binary = root / "spawn"
    stamp = root / "stamp"
    root.mkdir(parents=True, exist_ok=True)

    if not (checkout / ".git").exists():
        if checkout.exists():
            shutil.rmtree(checkout)
        run([git, "clone", "--filter=blob:none", "--no-checkout", SPAWN_REPO, str(checkout)])

    run([git, "fetch", "--depth", "1", "origin", SPAWN_REF], cwd=checkout)
    resolved = run([git, "rev-parse", "FETCH_HEAD"], cwd=checkout, capture=True).stdout.strip()
    expected_stamp = f"{resolved}:{PATCH_VERSION}"
    if binary.exists() and stamp.exists() and stamp.read_text().strip() == expected_stamp:
        return binary

    run([git, "reset", "--hard", "FETCH_HEAD"], cwd=checkout)
    run([git, "clean", "-fdx"], cwd=checkout)
    patch_agent_setup(checkout / "packages/cli/src/shared/agent-setup.ts")
    patch_oauth(checkout / "packages/cli/src/shared/oauth.ts")

    env = os.environ.copy()
    env["HUSKY"] = "0"
    run([bun, "install", "--frozen-lockfile"], cwd=checkout, env=env)
    run([bun, "run", "compile"], cwd=checkout / "packages/cli", env=env)
    shutil.copy2(checkout / "packages/cli/spawn", binary)
    binary.chmod(0o755)
    stamp.write_text(expected_stamp + "\n")
    return binary


def with_default_model(args):
    if not args or args[0] not in SUPPORTED_AGENTS:
        return args
    if "--model" in args:
        return args
    return [*args, "--model", DEFAULT_MODEL]


def main():
    if not os.environ.get("ALBERT_API_KEY", "").strip():
        die("ALBERT_API_KEY is not set")
    args = sys.argv[1:]
    if args and args[0] in KNOWN_AGENTS and args[0] not in SUPPORTED_AGENTS:
        print(
            f"albert spawn: {args[0]} still uses OpenRouter-specific integration upstream; continuing best-effort",
            file=sys.stderr,
        )
    binary = ensure_spawn()
    env = os.environ.copy()
    env.setdefault("SPAWN_TELEMETRY", "0")
    os.execve(binary, [str(binary), *with_default_model(args)], env)


if __name__ == "__main__":
    main()
